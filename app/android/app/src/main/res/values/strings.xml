<?xml version="1.0" encoding="utf-8"?>
<!--
  Strings the platform renders on our behalf, which therefore cannot come from the app's own
  catalogs: the download notification is built by Android from a Service that may run with no
  Flutter engine attached. Everything the app itself draws is localised through i18n/.
-->
<resources>
    <string name="download_channel_name">Downloads</string>
    <string name="download_notification_title">Downloading music</string>
    <string name="download_notification_progress">%1$d of %2$d</string>
</resources>
